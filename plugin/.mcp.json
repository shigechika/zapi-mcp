{
  "mcpServers": {
    "zapi-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": ["zapi-mcp"],
      "env": {
        "ZABBIX_URL": "${ZABBIX_URL:-}",
        "ZABBIX_USER": "${ZABBIX_USER:-}",
        "ZABBIX_PASSWORD": "${ZABBIX_PASSWORD:-}",
        "ZABBIX_CATEGORIES_INI": "${ZABBIX_CATEGORIES_INI:-}",
        "ZABBIX_BRIEF_RECENT_HOURS": "${ZABBIX_BRIEF_RECENT_HOURS:-24}",
        "ZABBIX_BRIEF_PROBLEM_LIMIT": "${ZABBIX_BRIEF_PROBLEM_LIMIT:-1000}"
      }
    }
  }
}
